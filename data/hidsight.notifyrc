[Global]
IconName=de.tordenskjold.hidsight
Name=Hidsight
Comment=Hidsight
DesktopEntry=de.tordenskjold.hidsight

[Event/batteryLow]
Name=Battery low
Comment=A keyboard or mouse reports a low battery
Action=Popup

[Event/batteryCritical]
Name=Battery critically low
Comment=A keyboard or mouse reports a critically low battery
Action=Popup
Urgency=Critical

[Event/chargeComplete]
Name=Charge complete
Comment=A keyboard or mouse is fully charged
Action=Popup
Urgency=Low
